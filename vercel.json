{
  "crons": [
    {
      "path": "/api/cron/notify",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=30, stale-while-revalidate=60" }
      ]
    }
  ]
}
